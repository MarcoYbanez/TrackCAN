/{
		aliases{
				rand-gen = &trng;
				eng-spi = &engine_management_spi;
				out = &out;
				in = &in;
		};

		chosen {

        zephyr,console = &lpuart6;
        zephyr,canbus = &flexcan3;

    };

		user
		{
				compatible = "gpio-leds";
				out: out-pin{
						gpios = <&gpio2 17 GPIO_ACTIVE_HIGH>;
						label = "my pin";
				};

				in: in-pin{
						gpios = <&gpio2 10 GPIO_ACTIVE_HIGH>;
						label = "my in pin";
				};
		};
};

&lpspi3{
		status = "okay";

		cs-gpios = <&gpio1 28 GPIO_ACTIVE_LOW>;

		engine_management_spi: engine-management-spi@0{
				compatible = "vnd,spi-device";
				reg = <0>;
				spi-max-frequency = <1000000>;
				/* spi-cpol; */

				spi-interframe-delay-ns = <0>;
						/* description: | */
						/*   Delay in nanoseconds between SPI words. */
						/*   Default of 0 is special value which will assume to mean half of the SCK period. */

				spi-cs-setup-delay-ns = <100>;
						/* description: | */
						/*   Delay in nanoseconds to be introduced by the controller after CS is asserted. */
						/*   Also known as enable lead time. */

				spi-cs-hold-delay-ns = <100>;
						/* description: | */
						/*  Delay in nanoseconds to be introduced by the controller before the CS is de-asserted. */
						/*   Also known as enable lag time. */

		};

};

&pinmux_lpspi3{
		status = "okay";
};

&gpio1{
		status = "okay";
};

&gpio2{
		status = "okay";
};

&trng{
		status = "okay";
};

/* Ethernet */
&enet {
		status = "disabled";
};

&enet_mac {
		status = "disabled";
};

&enet_mdio {
		status = "disabled";
};

/* TrackCAN backbone: FlexCAN3 on Teensy pins 31 (TX) / 30 (RX), as in
 * assets/DataLogger_schematic.drawio.svg. Needs an external transceiver, the Teensy 4.1
 * has none. FlexCAN3 is the CAN FD capable controller, but it stays in classic CAN mode
 * (the driver only enables FD when CAN_MODE_FD is requested, which TrackCAN never does).
 * 500 kbit/s classic CAN. */
&flexcan3 {
		status = "okay";
		bitrate = <500000>;

		can-transceiver {
				max-bitrate = <1000000>;
		};
};

/* The board enables FlexCAN1 (pins 22/23) by default. TrackCAN does not use it, so free
 * those pins. */
&flexcan1 {
		status = "disabled";
};

&zephyr_udc0 {
	usb_serial: usb_serial {
		compatible = "zephyr,cdc-acm-uart";
	};
};
